{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "intro_guide_seen": {
      "type": "boolean",
      "default": false,
      "description": "Om introduktionsguiden visats eller hopparats \u00f6ver"
    },
    "email_connected": {
      "type": "boolean",
      "default": false,
      "description": "Om anv\u00e4ndaren kopplat sin e-post f\u00f6r digitala kvitton"
    },
    "connected_email": {
      "type": "string",
      "description": "Den kopplade e-postadressen"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Om anv\u00e4ndaren slagit p\u00e5 notiser (web push)"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Om anv\u00e4ndaren har Handlis+"
    },
    "premium_since": {
      "type": "string",
      "format": "date-time",
      "description": "N\u00e4r Handlis+ aktiverades"
    }
  },
  "required": [
    "role"
  ]
}